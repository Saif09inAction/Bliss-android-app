rules_version = '2';

// Laiza Bags — Firestore Security Rules
//
// Clients: Android app (Staff + Kaariger) and Bliss admin web panel.
// Auth today: custom phone + password documents (NOT Firebase Authentication).
// Rules stay permissive on most collections until you migrate to Firebase Auth
// and use request.auth + custom claims (role: admin | staff | kaariger).
//
// Deploy: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Admins (web panel login)
    // Login uses get on admins/{phone}. Panel can list/create/update/delete.
    // -------------------------------------------------------------------------
    match /admins/{adminPhone} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // Employees — Staff & Kaariger profiles + login credentials
    // Android: login, profile, kaariger list for orders
    // Admin web: full CRUD
    // -------------------------------------------------------------------------
    match /employees/{employeePhone} {
      allow read, write: if true;
    }

    match /employee_profiles/{phone} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // Inventory
    // Admin web: raw materials CRUD
    // Android staff: finished products read/update (pickup/return, approvals)
    // -------------------------------------------------------------------------
    match /raw_materials/{materialId} {
      allow read, write: if true;
    }

    match /finished_products/{productId} {
      allow read, write: if true;
    }

    match /product_catalog/{productId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // Kaariger workflow
    // Admin web: create orders, record advances
    // Android kaariger: view/submit deliveries
    // Android staff: approve/reject pending orders
    // -------------------------------------------------------------------------
    match /kaariger_orders/{orderId} {
      allow read, write: if true;
    }

    match /kaariger_payments/{paymentId} {
      allow read, write: if true;
    }

    match /order_approval_records/{recordId} {
      allow read, write: if true;
    }

    match /order_repairs/{repairId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // Staff operations
    // -------------------------------------------------------------------------
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    match /payments/{paymentId} {
      allow read, write: if true;
    }

    match /pickup_records/{recordId} {
      allow read, write: if true;
    }

    match /return_records/{recordId} {
      allow read, write: if true;
    }

    match /delivery_partners/{partnerId} {
      allow read, write: if true;
    }

    match /marketplace_companies/{companyId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // App settings (attendance times, etc.)
    // -------------------------------------------------------------------------
    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /calendar_days/{dayId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // Bill Report — supplier ledgers under Claris / Bliss
    // -------------------------------------------------------------------------
    match /bill_companies/{companyId} {
      allow read, write: if true;
    }

    match /bill_entries/{entryId} {
      allow read, write: if true;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
